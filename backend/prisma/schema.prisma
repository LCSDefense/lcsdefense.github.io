generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Requisition {
  id            Int       @id @default(autoincrement())
  customer      String
  position      String
  dateReceived  DateTime  @default(now())
  hiringManager String?
  contract      String?
  workLocation  String?
  status        String    @default("Open")
  openSlots     Int       @default(1)
  recruiter     String?
  notes         String?
  folderLink    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  applications  Application[]
}

model Candidate {
  id                    Int       @id @default(autoincrement())
  name                  String
  email                 String?
  phone                 String?
  homeAddress           String?
  currentPosition       String?
  currentCompany        String?
  clearanceLevel        String?
  clearanceConfirmedBy  String?
  clearanceConfirmDate  DateTime?
  salaryExpectation     String?
  sourcedBy             String?
  resumeLink            String?
  linkedInUrl           String?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  applications          Application[]
}

model Application {
  id                  Int       @id @default(autoincrement())
  candidateId         Int
  requisitionId       Int
  candidate           Candidate  @relation(fields: [candidateId], references: [id])
  requisition         Requisition @relation(fields: [requisitionId], references: [id])
  pipelineStage       String    @default("Initial Contact")
  alignmentPct        Int?
  clientStatus        String?
  dateInitialContact  DateTime?
  dateInterested      DateTime?
  dateLCSInterview    DateTime?
  dateSentToClient    DateTime?
  dateClientInterview DateTime?
  offerAmount         String?
  dateOffer           DateTime?
  recruiter           String?
  jobDescription      String?
  internalNotes       String?
  dateOpened          DateTime  @default(now())
  dateFilled          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  onboardingRecord    OnboardingRecord?
}

model OnboardingRecord {
  id                          Int       @id @default(autoincrement())
  applicationId               Int       @unique
  application                 Application @relation(fields: [applicationId], references: [id])
  employeeName                String
  personalEmail               String?
  personalPhone               String?
  homeAddress                 String?
  hiringManager               String?
  startDate                   DateTime?
  position                    String?
  customer                    String?
  contract                    String?
  taskOrderNumber             String?
  workLocation                String?
  requiredClearance           String?
  clearanceLevelVerification  String?
  salary                      String?
  signOnBonus                 String?
  offerType                   String?
  awsIdNumber                 String?
  awsLaborCategory            String?
  awsTargetRate               String?
  customerPOC                 String?
  dob                         String?
  ssn                         String?
  salaryDotComRange           String?
  desiredSalary               String?
  estimatedTargetRate         String?
  billRate                    String?
  lcsEmailAddress             String?
  milEmailAddress             String?
  apgBuildingNumber           String?
  company                     String?
  c5isrDirectorate            String?
  c5isrDivision               String?
  c5isrBranch                 String?
  effortProjectName           String?
  personalCell                String?
  workCell                    String?
  officeNumber                String?
  cacRequired                 String?
  cacType                     String?
  cacEdipi                    String?
  cacExpiration               DateTime?
  visitRequestRequired        String?
  campusBadgeRequired         Boolean   @default(false)
  saarsRequired               Boolean   @default(false)
  fsoInfo                     String?
  gtlInfo                     String?
  branchChief                 String?
  lcsManager                  String?
  onSiteAdmin                 String?
  plc                         String?
  laborCategory               String?
  laborChargeCode             String?
  jobDescription              String?
  onboardingStatus            String    @default("Not Started")
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  checklistItems              ChecklistItem[]
}

model ChecklistItem {
  id                 Int       @id @default(autoincrement())
  onboardingRecordId Int
  onboardingRecord   OnboardingRecord @relation(fields: [onboardingRecordId], references: [id])
  category           String
  task               String
  isComplete         Boolean   @default(false)
  completedDate      DateTime?
  assignedTo         String?
  dueDate            DateTime?
  notes              String?
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}
